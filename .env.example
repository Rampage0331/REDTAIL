# Stripe (sandbox/test keys). Run `stripe login` then `stripe sandbox create`
# with the Stripe CLI to generate these, or copy them from the Dashboard.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally,
# or the Dashboard webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# Database (Prisma). Defaults to local SQLite for development — swap for a
# hosted Postgres connection string (and update the provider in
# prisma/schema.prisma) before deploying to production.
DATABASE_URL="file:./dev.db"

# Used to build Stripe success/cancel redirect URLs. Set to your deployed
# origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Temporary site-wide password lock (set SITE_LOCKED=true only where you
# want the lock active, e.g. production, while the site isn't ready to
# be public). Leave unset/false for local dev.
SITE_LOCKED=false
SITE_AUTH_USER=
SITE_AUTH_PASSWORD=

# Ad tracking pixels (all optional). Leave unset until you actually have
# accounts with these platforms — each stays inactive until its ID is set.
META_PIXEL_ID=
GA_MEASUREMENT_ID=
TIKTOK_PIXEL_ID=
